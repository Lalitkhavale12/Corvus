# Python
__pycache__/
*.py[cod]
venv/
.venv/
*.egg-info/

# Data & artifacts
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/nhanes/*.xpt
data/nhanes/*.csv
# The NHANES XPTs are ~40 MB and re-downloadable; the finished cohort CSV is
# 2.3 MB, so it is committed and training is reproducible without them.
!data/nhanes/nhanes_ckd_multi.csv
# Third-party dataset received for cross-checking only (not ours to publish)
data/Prof Data/
mlruns/
models/*
!models/.gitkeep
logs/*
!logs/.gitkeep
reports/*
!reports/.gitkeep

# Env / secrets
.env
*.env
!.env.example

# OS / editor
.DS_Store
.idea/
.vscode/
# Test / probe databases (never committed)
*.db

# Node / tool state (never part of the Python project)
node_modules/
website/playwright-report/
website/test-results/
website/e2e/.auth/
.pytest_cache/
.ruff_cache/
*.log
.archify/
.claude-flow/
.opencode/
.gsd/
