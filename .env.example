# Corvus local development environment (template).
# Copy to .env before the first `docker compose up`:
#   Windows:  Copy-Item .env.example .env
#   Unix:     cp .env.example .env
# .env is gitignored; never commit real secrets.

# JWT signing key. The API refuses to start without it (no baked-in default,
# because a published fallback key would let anyone forge tokens).
# Generate your own for anything beyond local dev:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=corvus-dev-secret-change-in-production

# Database URL used by the API container. "db" is the compose service name.
DATABASE_URL=postgresql+psycopg2://corvus:corvus@db:5432/corvus

# API base URL baked into the frontend build.
VITE_API_URL=http://localhost:8000
